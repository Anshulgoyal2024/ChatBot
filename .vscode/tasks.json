{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: FastAPI (local)",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "local-backend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Uvicorn running on http://127\\.0\\.0\\.1:8000"
        }
      }
    },
    {
      "label": "Frontend: Vite (local)",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "local-frontend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:\\s+http://localhost:3001/"
        }
      }
    },
    {
      "label": "Run local app",
      "dependsOn": ["Backend: FastAPI (local)", "Frontend: Vite (local)"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
